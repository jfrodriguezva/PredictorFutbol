# ML artifacts — *.joblib tracked via Git LFS (see .gitattributes), *.pkl excluded
ml/models/*.pkl

# SQLite database — tracked via Git LFS (see .gitattributes); only journal files excluded
database/*.db-shm
database/*.db-wal

# Desktop launcher — machine-specific paths, never shared
desktop/SportsPredictor.Desktop/launcher.settings.local.json

# Installer build output
installer/output/

# Legacy agent source (kept for reference only, see legacy/README) — local data/model artifacts excluded
legacy/predictor-agent-source/ml-service/data/*
!legacy/predictor-agent-source/ml-service/data/.gitkeep
legacy/predictor-agent-source/ml-service/*.db
legacy/predictor-agent-source/web/tsconfig.tsbuildinfo

