# Copy this file to .env or configure equivalent environment variables locally.
# NEVER commit your real API key.

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# SQLite (local file, no database server required)
SQLITE_DB_PATH=./database/sportspredictor.db

# Backend
ASPNETCORE_ENVIRONMENT=Development

# Python ML
ML_SERVICE_URL=http://localhost:8001

# Anthropic (Claude) — used by ml/narrative/generate.py for the POST /analyze/football-1x2
# narrative. Optional: without it, that endpoint falls back to a template narrative.
ANTHROPIC_API_KEY=

# Frontend (also see frontend/.env.example, which is the one actually read by `npm run dev`)
NEXT_PUBLIC_API_BASE_URL=http://localhost:20050
