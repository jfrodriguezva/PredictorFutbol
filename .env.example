# Copia este archivo a .env.local (apps/web) y .env (apps/ml-service) y llena los valores reales.
# NUNCA subas .env.local o .env con valores reales a git.

# API-Football (RapidAPI) - https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# The Odds API - https://the-odds-api.com/
ODDS_API_KEY=

# Anthropic (Claude) - para la narrativa "experto en apuestas"
ANTHROPIC_API_KEY=

# Base de datos (SQLite local por ahora; cambia a postgres://... en producción)
DATABASE_URL=sqlite:///./data/predictor.db

# URL del servicio ml-service, usada desde Next.js
ML_SERVICE_URL=http://localhost:8000
