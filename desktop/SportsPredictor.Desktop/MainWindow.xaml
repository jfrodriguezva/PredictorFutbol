<Window x:Class="SportsPredictor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sports Predictor" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Startup / status screen, shown until every service is confirmed healthy. -->
        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
            <TextBlock Text="Sports Predictor" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24" />
            <TextBlock x:Name="MlStatusText" Text="ML service: waiting…" Margin="0,4" />
            <TextBlock x:Name="ApiStatusText" Text="API: waiting…" Margin="0,4" />
            <TextBlock x:Name="FrontendStatusText" Text="Dashboard: waiting…" Margin="0,4" />
            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- The actual dashboard, once everything is up. -->
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
    </Grid>
</Window>
